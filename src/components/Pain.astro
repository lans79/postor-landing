---
const mistakes = [
  {
    num: '01',
    title: 'Универсальный маркетолог',
    text: 'Сегодня рекламирует пиццу, завтра — вас. Не знает разницу между роторной и экстракционной чисткой. Результат — объявления, которые привлекают не ваших клиентов.',
  },
  {
    num: '02',
    title: 'Фото со стока',
    text: '«Счастливая хозяйка» вместо реального цеха. Ваш клиент с первого взгляда понимает: это не про меня. CTR падает, цена лида растёт.',
  },
  {
    num: '03',
    title: 'Процент от бюджета',
    text: 'Агентству выгодно тратить больше вашего бюджета — их гонорар растёт вместе с расходами. У нас — фикс. Нам выгодно, чтобы росли ваши заказы.',
  },
]

const stats = [
  { value: 'Фикс. цена', label: 'нам невыгодно тратить ваш бюджет впустую' },
  { value: '1 город', label: 'не работаем с вашими конкурентами' },
  { value: 'Договор', label: 'KPI и стоимость фиксируем до старта' },
  { value: '1 день', label: 'до первых заявок после запуска рекламы' },
]
---

<section class="section-padding" style="background:var(--gray-light);">
  <div class="container">

    <div class="pain-header-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start;margin-bottom:2rem;">
      <div>
        <p class="section-label reveal">Почему это важно</p>
        <h2 class="section-title reveal" style="font-size:clamp(2rem,5vw,4.5rem);">
          Три ошибки,<br />которые<br />стоят вам<br /><span style="color:var(--accent);">клиентов</span>
        </h2>
      </div>
      <div>
        <p class="reveal" style="color:var(--gray-text);font-size:1.125rem;font-weight:500;line-height:1.4;margin-bottom:1.5rem;">
          Большинство химчисток сталкиваются с одними и теми же проблемами в рекламе. Не потому что реклама не работает — а потому что подрядчик не знает вашу нишу.
        </p>
        <div class="pain-stats reveal">
          {stats.map((s) => (
            <div class="pain-stat">
              <span class="pain-stat__value">{s.value}</span>
              <span class="pain-stat__label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:1rem;">
      {mistakes.map((m, i) => (
        <div
          class={`pain-mistake-card reveal reveal-delay-${i + 1}`}
          style="background:var(--white);border-radius:2rem;padding:2.5rem 3rem;display:grid;grid-template-columns:80px 1fr 2fr;gap:2rem;align-items:center;border:1px solid var(--border-light);transition:all 0.4s;"
        >
          <span style="font-family:'Unbounded',sans-serif;font-weight:900;font-size:2.5rem;color:var(--border-light);letter-spacing:-0.025em;">
            {m.num}
          </span>
          <h3 style="font-family:'Unbounded',sans-serif;font-weight:800;font-size:1.1rem;text-transform:uppercase;letter-spacing:-0.02em;">
            {m.title}
          </h3>
          <p style="color:var(--gray-text);font-size:0.9rem;font-weight:500;line-height:1.4;">
            {m.text}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .pain-mistake-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px -10px rgba(15,15,15,0.08);
  }
  @media (max-width: 1024px) {
    .pain-header-grid { grid-template-columns: 1fr !important; gap: 2rem !important; }
  }
  @media (max-width: 768px) {
    .pain-mistake-card {
      grid-template-columns: 1fr !important;
      padding: 1.5rem !important;
    }
  }
</style>
